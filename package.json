{
  "name": "gladys-storcube",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for StorCube balcony batteries (S1000) through the StorCube cloud: one device per battery, output setpoint, discharge threshold, scene triggers, dashboard widget.",
  "homepage": "https://github.com/William-De71/gladys-storcube",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-storcube.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "storcube",
    "s1000",
    "balcony-battery",
    "solar",
    "battery",
    "energy",
    "home-automation"
  ]
}
